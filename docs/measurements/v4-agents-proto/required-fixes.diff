diff --git a/crates/agents/src/live.rs b/crates/agents/src/live.rs
new file mode 100644
index 0000000..c7ab1af
--- /dev/null
+++ b/crates/agents/src/live.rs
@@ -0,0 +1,55 @@
+//! Helpers the live checks `s1` and `s2` share.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+
+use anyhow::Result;
+
+#[derive(Debug, Clone, Copy)]
+pub enum Presence {
+    Present,
+    Missing,
+}
+pub fn presence(path: &Path) -> Presence {
+    match std::fs::metadata(path) {
+        Ok(_) => Presence::Present,
+        Err(_) => Presence::Missing,
+    }
+}
+#[derive(Clone, Copy)]
+pub enum Verdict {
+    Pass,
+    Fail,
+}
+pub fn report(step: &str, verdict: Verdict, detail: String) -> Result<Verdict> {
+    let label = match verdict {
+        Verdict::Pass => "PASS",
+        Verdict::Fail => "FAIL",
+    };
+    writeln!(std::io::stdout(), "{label} {step}: {detail}")?;
+    Ok(verdict)
+}
+pub fn log_path(fixtures: Option<&Path>, name: &str) -> Option<PathBuf> {
+    fixtures.map(|dir| {
+        let path = dir.join(format!("{name}.jsonl"));
+        let _ = std::fs::remove_file(&path);
+        path
+    })
+}
+pub fn fresh_scratch(scratch: &Path) -> Result<()> {
+    if let Presence::Present = presence(scratch) {
+        std::fs::remove_dir_all(scratch)?;
+    }
+    std::fs::create_dir_all(scratch)?;
+    let git = std::process::Command::new("git")
+        .args(["init", "-q"])
+        .current_dir(scratch)
+        .status()?;
+    match git.code() {
+        Some(0) => Ok(()),
+        _ => Err(anyhow::Error::msg(format!(
+            "git init failed in {}",
+            scratch.display()
+        ))),
+    }
+}
