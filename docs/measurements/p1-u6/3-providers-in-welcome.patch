diff --git a/crates/proto/src/lib.rs b/crates/proto/src/lib.rs
index a687993..8ed7d79 100644
--- a/crates/proto/src/lib.rs
+++ b/crates/proto/src/lib.rs
@@ -160,6 +160,30 @@ pub struct Welcome {
     pub host: String,
     pub epoch: Epoch,
     pub head_seq: HostSeq,
+    pub providers: Providers,
+}
+
+/// Whether the host can run each provider, fixed when it starts.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Providers {
+    pub claude: Availability,
+    pub codex: Availability,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum Availability {
+    Available,
+    /// The host can't run this provider's sessions, for this reason.
+    Unavailable { reason: String },
+}
+
+impl Providers {
+    pub fn of(&self, provider: Provider) -> &Availability {
+        match provider {
+            Provider::Claude => &self.claude,
+            Provider::Codex => &self.codex,
+        }
+    }
 }
 
