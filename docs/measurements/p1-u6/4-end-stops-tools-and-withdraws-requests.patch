Subject: [PATCH] G2

---
 crates/app/src/session.rs      |  1 +
 crates/client/src/host_view.rs | 98 +++++++++++++++++++++++++++++++++-
 crates/client/src/link.rs      |  4 +-
 3 files changed, 100 insertions(+), 3 deletions(-)

diff --git a/crates/app/src/session.rs b/crates/app/src/session.rs
index 9ad2e20..d90e095 100644
--- a/crates/app/src/session.rs
+++ b/crates/app/src/session.rs
@@ -107,6 +107,7 @@ fn TranscriptItem(item: Item, on_decide: EventHandler<(RequestId, Decision)>) ->
                 ToolState::Finished(ToolOutcome::Succeeded) => "succeeded",
                 ToolState::Finished(ToolOutcome::Failed) => "failed",
                 ToolState::Finished(ToolOutcome::Declined) => "declined",
+                ToolState::Stopped => "stopped",
             };
             rsx! {
                 div { class: "tool", "data-state": state, title: state,
diff --git a/crates/client/src/host_view.rs b/crates/client/src/host_view.rs
index 1b76139..72773d1 100644
--- a/crates/client/src/host_view.rs
+++ b/crates/client/src/host_view.rs
@@ -69,6 +69,8 @@ pub enum ReplyState {
 pub enum ToolState {
     Running,
     Finished(ToolOutcome),
+    /// The turn or the session ended before the call finished.
+    Stopped,
 }
 
 #[derive(Debug, Clone, PartialEq, Eq)]
@@ -82,6 +84,9 @@ pub enum RequestState {
 enum Change {
     Resolve(RequestId, Resolution),
     Finish(ToolCallId, ToolOutcome),
+    /// The turn or the session ended: nothing still running will finish, and
+    /// nothing still open will be answered.
+    End,
 }
 
 impl SessionStatus {
@@ -227,7 +232,9 @@ impl SessionView {
         match kind {
             EventKind::SessionCreated { .. } => self,
             EventKind::SessionReady => self.status(SessionStatus::Idle),
-            EventKind::SessionClosed { reason } => self.status(SessionStatus::Closed(reason)),
+            EventKind::SessionClosed { reason } => self
+                .change(Change::End)
+                .status(SessionStatus::Closed(reason)),
             EventKind::UserMessage { text, by } => self
                 .status(SessionStatus::Running)
                 .push(Item::User { text, by }),
@@ -260,6 +267,7 @@ impl SessionView {
                 resolution,
             } => self.change(Change::Resolve(request, resolution)),
             EventKind::TurnCompleted { outcome } => self
+                .change(Change::End)
                 .status(SessionStatus::Idle)
                 .push(Item::TurnCompleted(outcome)),
             EventKind::Error { message } => self.push(Item::Error(message)),
@@ -347,6 +355,32 @@ impl Item {
                 call,
                 tool,
             },
+            (
+                Item::Tool {
+                    call,
+                    tool,
+                    state: ToolState::Running,
+                },
+                Change::End,
+            ) => Item::Tool {
+                call,
+                tool,
+                state: ToolState::Stopped,
+            },
+            (
+                Item::Request {
+                    request,
+                    tool,
+                    detail,
+                    state: RequestState::Open,
+                },
+                Change::End,
+            ) => Item::Request {
+                request,
+                tool,
+                detail,
+                state: RequestState::Resolved(Resolution::Withdrawn),
+            },
             (item, _) => item,
         }
     }
@@ -608,4 +642,66 @@ mod tests {
             Vec::from([Attention::Requests(2), Attention::Quiet])
         );
     }
+
+    fn ended(request: u64) -> Item {
+        Item::Request {
+            request: RequestId(request),
+            tool: text("Bash"),
+            detail: text("ls"),
+            state: RequestState::Resolved(Resolution::Withdrawn),
+        }
+    }
+
+    #[test]
+    fn the_end_of_a_turn_or_session_stops_running_tools_and_withdraws_open_requests() {
+        let view = fold(Vec::from([
+            (1, created("/a")),
+            (
+                1,
+                EventKind::ToolCall {
+                    call: ToolCallId(text("t1")),
+                    phase: ToolPhase::Started {
+                        tool: ToolKind::Command {
+                            command: text("ls"),
+                        },
+                    },
+                },
+            ),
+            (1, opened(1)),
+            (
+                1,
+                EventKind::TurnCompleted {
+                    outcome: TurnOutcome::Interrupted,
+                },
+            ),
+            (2, created("/b")),
+            (2, opened(2)),
+            (
+                2,
+                EventKind::SessionClosed {
+                    reason: CloseReason::Exited { status: text("0") },
+                },
+            ),
+        ]));
+        assert_eq!(
+            view.sessions
+                .values()
+                .map(|session| session.items.clone())
+                .collect::<Vec<Vec<Item>>>(),
+            Vec::from([
+                Vec::from([
+                    Item::Tool {
+                        call: ToolCallId(text("t1")),
+                        tool: ToolKind::Command {
+                            command: text("ls")
+                        },
+                        state: ToolState::Stopped,
+                    },
+                    ended(1),
+                    Item::TurnCompleted(TurnOutcome::Interrupted),
+                ]),
+                Vec::from([ended(2)]),
+            ])
+        );
+    }
 }
