diff --git a/Cargo.toml b/Cargo.toml
index 29952f0..934081e 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -21,3 +21,69 @@ thiserror = "2.0.21"
 tokio = { version = "1.54.1", features = ["process", "io-util", "sync", "macros", "rt-multi-thread", "time"] }
 tracing = "0.1.44"
 tracing-subscriber = { version = "0.3.23", features = ["env-filter"] }
+
+# The style is an allowlist: every lint group is denied, and each entry below
+# that permits something says why. Call sites use
+# `#[expect(lint, reason = "...")]`; `#[allow]` is itself denied, so an
+# exception that stops being needed fails the build. Adding an entry here
+# needs the owner's approval (AGENTS.md, "Lint allowlist").
+[workspace.lints.rust]
+unsafe_code = "forbid"
+warnings = { level = "deny", priority = -1 }
+future_incompatible = { level = "deny", priority = -1 }
+nonstandard_style = { level = "deny", priority = -1 }
+rust_2018_idioms = { level = "deny", priority = -1 }
+let_underscore = { level = "deny", priority = -1 }
+missing_docs = "deny"
+missing_debug_implementations = "deny"
+unreachable_pub = "deny"
+unused_results = "deny"
+unused_qualifications = "deny"
+unused_lifetimes = "deny"
+unused_import_braces = "deny"
+unused_macro_rules = "deny"
+single_use_lifetimes = "deny"
+redundant_lifetimes = "deny"
+explicit_outlives_requirements = "deny"
+meta_variable_misuse = "deny"
+trivial_casts = "deny"
+trivial_numeric_casts = "deny"
+unit_bindings = "deny"
+non_ascii_idents = "deny"
+unnameable_types = "deny"
+
+[workspace.lints.clippy]
+pedantic = { level = "deny", priority = -1 }
+nursery = { level = "deny", priority = -1 }
+restriction = { level = "deny", priority = -1 }
+cargo = { level = "deny", priority = -1 }
+# Allowlist.
+blanket_clippy_restriction_lints = { level = "allow", reason = "the restriction group is enabled on purpose; this list is the allowlist" }
+implicit_return = { level = "allow", reason = "expression-oriented style: the last expression is the value; `return` is for early exits" }
+question_mark_used = { level = "allow", reason = "`?` is how errors propagate" }
+missing_docs_in_private_items = { level = "allow", reason = "public items need docs (missing_docs); private code comments only the non-obvious why" }
+missing_inline_in_public_items = { level = "allow", reason = "the compiler decides inlining" }
+single_call_fn = { level = "allow", reason = "a single-use function is judged in review: it must earn its name" }
+exhaustive_enums = { level = "allow", reason = "workspace-internal types; nothing is published" }
+exhaustive_structs = { level = "allow", reason = "workspace-internal types; nothing is published" }
+pattern_type_mismatch = { level = "allow", reason = "match ergonomics are idiomatic" }
+std_instead_of_core = { level = "allow", reason = "not a no_std project" }
+std_instead_of_alloc = { level = "allow", reason = "not a no_std project" }
+alloc_instead_of_core = { level = "allow", reason = "not a no_std project" }
+pub_with_shorthand = { level = "allow", reason = "we write `pub(crate)`; pub_without_shorthand stays denied" }
+redundant_pub_crate = { level = "allow", reason = "contradicts unreachable_pub; visibility is always explicit" }
+pub_use = { level = "allow", reason = "lib.rs re-exports define each crate's public surface" }
+self_named_module_files = { level = "allow", reason = "`foo.rs` + `foo/`; mod_module_files stays denied" }
+separated_literal_suffix = { level = "allow", reason = "we write `1_u32`; unseparated_literal_suffix stays denied" }
+semicolon_inside_block = { level = "allow", reason = "contradicts semicolon_outside_block, which stays denied" }
+big_endian_bytes = { level = "allow", reason = "wire formats name their byte order; host_endian_bytes stays denied" }
+little_endian_bytes = { level = "allow", reason = "wire formats name their byte order; host_endian_bytes stays denied" }
+module_name_repetitions = { level = "allow", reason = "types are named for use outside their module (`SessionError`); error_impl_error stays denied" }
+tests_outside_test_module = { level = "allow", reason = "integration tests in tests/ are crate roots" }
+single_char_lifetime_names = { level = "allow", reason = "`'a` is idiomatic" }
+missing_trait_methods = { level = "allow", reason = "trait default methods are meant to be inherited" }
+non_ascii_literal = { level = "allow", reason = "user-facing text uses real typography" }
+use_debug = { level = "allow", reason = "Debug formatting is for logs and test messages" }
+multiple_crate_versions = { level = "allow", reason = "duplicates inside dependencies are not ours to fix" }
+future_not_send = { level = "allow", reason = "browser futures are !Send by nature" }
+
